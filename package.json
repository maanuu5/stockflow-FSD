{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StockFlow – Full-Stack Inventory Management System",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "db:empty": "npm --prefix server run db:empty",
    "db:reset": "npm --prefix server run db:reset",
    "dev": "concurrently -n API,WEB -c blue,green \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
