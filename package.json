{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "description": "StockFlow – Full-Stack Inventory Management System",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "db:empty": "npm --prefix server run db:empty",
    "db:reset": "npm --prefix server run db:reset",
    "dev": "concurrently -n API,WEB -c blue,green \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

